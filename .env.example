# AI Creative Studio – environment configuration
# Copy to `.env` and adjust. `.env` is git-ignored – never commit secrets.
#
# Nested settings use double underscores: ACS__<SECTION>__<KEY>
# These override configs/studio.yaml and configs/studio.local.yaml.

# --- Server ---------------------------------------------------------------
# ACS__SERVER__HOST=127.0.0.1
# ACS__SERVER__PORT=8420
# Optional API token. If set, every API call (and the MCP server) must send it.
# ACS_API_TOKEN=change-me

# --- ComfyUI --------------------------------------------------------------
# URL of a running ComfyUI instance (installed by setup or your own).
# ACS__COMFYUI__URL=http://127.0.0.1:8188
# Path of a ComfyUI installation (used by start scripts and model downloads).
# ACS__PATHS__COMFYUI_DIR=engines/comfyui/ComfyUI

# --- External tools -------------------------------------------------------
# ACS__FFMPEG__FFMPEG_PATH=ffmpeg
# ACS__FFMPEG__FFPROBE_PATH=ffprobe
# ACS__BLENDER__BLENDER_PATH=blender

# --- Hardware profile (auto | low | mid | high) -----------------------------
# ACS__HARDWARE__PROFILE=auto

# --- MCP server -----------------------------------------------------------
# Backend URL the MCP server talks to.
# ACS_MCP_BACKEND_URL=http://127.0.0.1:8420

# --- Optional cloud providers (DISABLED by default, cost money!) -----------
# Cloud providers are only usable when: enabled in configs/providers.local.yaml,
# a monthly budget > 0 is configured and every paid action is confirmed.
# Put API keys ONLY here (never in config files or code):
# EXAMPLE_CLOUD_API_KEY=
