{
  "meta": {
    "id": "z_image_turbo_txt2img",
    "name": "Z-Image Turbo – Text-to-Image",
    "task": "text_to_image",
    "kind": "image",
    "family": "z-image",
    "description": "Nachbau des offiziellen ComfyUI-Templates image_z_image_turbo (8 Schritte, cfg 1).",
    "parameters": {
      "model": {
        "targets": [
          [
            "1",
            "unet_name"
          ]
        ],
        "default": "z_image_turbo_bf16.safetensors"
      },
      "text_encoder": {
        "targets": [
          [
            "2",
            "clip_name"
          ]
        ],
        "default": "qwen_3_4b.safetensors"
      },
      "vae": {
        "targets": [
          [
            "3",
            "vae_name"
          ]
        ],
        "default": "ae.safetensors"
      },
      "shift": {
        "targets": [
          [
            "4",
            "shift"
          ]
        ],
        "default": 3.0
      },
      "prompt": {
        "targets": [
          [
            "5",
            "text"
          ]
        ],
        "required": true
      },
      "width": {
        "targets": [
          [
            "7",
            "width"
          ]
        ],
        "default": 1024
      },
      "height": {
        "targets": [
          [
            "7",
            "height"
          ]
        ],
        "default": 1024
      },
      "batch_size": {
        "targets": [
          [
            "7",
            "batch_size"
          ]
        ],
        "default": 1
      },
      "seed": {
        "targets": [
          [
            "8",
            "seed"
          ]
        ],
        "default": 0
      },
      "steps": {
        "targets": [
          [
            "8",
            "steps"
          ]
        ],
        "default": 8
      },
      "cfg": {
        "targets": [
          [
            "8",
            "cfg"
          ]
        ],
        "default": 1.0
      },
      "sampler": {
        "targets": [
          [
            "8",
            "sampler_name"
          ]
        ],
        "default": "res_multistep"
      },
      "scheduler": {
        "targets": [
          [
            "8",
            "scheduler"
          ]
        ],
        "default": "simple"
      },
      "filename_prefix": {
        "targets": [
          [
            "10",
            "filename_prefix"
          ]
        ],
        "default": "acs/zimage"
      }
    },
    "outputs": [
      "10"
    ]
  },
  "workflow": {
    "1": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "z_image_turbo_bf16.safetensors",
        "weight_dtype": "default"
      }
    },
    "2": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "qwen_3_4b.safetensors",
        "type": "lumina2"
      }
    },
    "3": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "ae.safetensors"
      }
    },
    "4": {
      "class_type": "ModelSamplingAuraFlow",
      "inputs": {
        "model": [
          "1",
          0
        ],
        "shift": 3.0
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "2",
          0
        ]
      }
    },
    "6": {
      "class_type": "ConditioningZeroOut",
      "inputs": {
        "conditioning": [
          "5",
          0
        ]
      }
    },
    "7": {
      "class_type": "EmptySD3LatentImage",
      "inputs": {
        "width": 1024,
        "height": 1024,
        "batch_size": 1
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "seed": 0,
        "steps": 8,
        "cfg": 1.0,
        "sampler_name": "res_multistep",
        "scheduler": "simple",
        "positive": [
          "5",
          0
        ],
        "negative": [
          "6",
          0
        ],
        "latent_image": [
          "7",
          0
        ],
        "denoise": 1.0
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "8",
          0
        ],
        "vae": [
          "3",
          0
        ]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "9",
          0
        ],
        "filename_prefix": "acs/zimage"
      }
    }
  }
}
