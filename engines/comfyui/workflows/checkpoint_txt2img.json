{
  "meta": {
    "id": "checkpoint_txt2img",
    "name": "Checkpoint – Text-to-Image (SD 1.5 / SDXL)",
    "task": "text_to_image",
    "kind": "image",
    "description": "Standard-Graph für All-in-one-Checkpoints. Mit sampling=lcm + LCM-LoRA für 4–8 Schritte.",
    "parameters": {
      "model": {
        "targets": [
          [
            "4",
            "ckpt_name"
          ]
        ],
        "required": true,
        "description": "Checkpoint file in models/checkpoints"
      },
      "sampling": {
        "targets": [
          [
            "12",
            "sampling"
          ]
        ],
        "default": "eps",
        "description": "eps (SD1.5/SDXL) or lcm (with LCM-LoRA)"
      },
      "prompt": {
        "targets": [
          [
            "6",
            "text"
          ]
        ],
        "required": true
      },
      "negative_prompt": {
        "targets": [
          [
            "7",
            "text"
          ]
        ],
        "default": ""
      },
      "seed": {
        "targets": [
          [
            "3",
            "seed"
          ]
        ],
        "default": 0
      },
      "steps": {
        "targets": [
          [
            "3",
            "steps"
          ]
        ],
        "default": 25
      },
      "cfg": {
        "targets": [
          [
            "3",
            "cfg"
          ]
        ],
        "default": 7.0
      },
      "sampler": {
        "targets": [
          [
            "3",
            "sampler_name"
          ]
        ],
        "default": "dpmpp_2m"
      },
      "scheduler": {
        "targets": [
          [
            "3",
            "scheduler"
          ]
        ],
        "default": "karras"
      },
      "filename_prefix": {
        "targets": [
          [
            "9",
            "filename_prefix"
          ]
        ],
        "default": "acs/image"
      },
      "width": {
        "targets": [
          [
            "5",
            "width"
          ]
        ],
        "default": 512
      },
      "height": {
        "targets": [
          [
            "5",
            "height"
          ]
        ],
        "default": 512
      },
      "batch_size": {
        "targets": [
          [
            "5",
            "batch_size"
          ]
        ],
        "default": 1
      }
    },
    "lora_anchor": {
      "model": [
        "4",
        0
      ],
      "clip": [
        "4",
        1
      ]
    },
    "outputs": [
      "9"
    ]
  },
  "workflow": {
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors"
      }
    },
    "12": {
      "class_type": "ModelSamplingDiscrete",
      "inputs": {
        "model": [
          "4",
          0
        ],
        "sampling": "eps",
        "zsnr": false
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "4",
          1
        ]
      }
    },
    "7": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "",
        "clip": [
          "4",
          1
        ]
      }
    },
    "5": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 512,
        "height": 512,
        "batch_size": 1
      }
    },
    "3": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "12",
          0
        ],
        "seed": 0,
        "steps": 25,
        "cfg": 7.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "karras",
        "positive": [
          "6",
          0
        ],
        "negative": [
          "7",
          0
        ],
        "latent_image": [
          "5",
          0
        ],
        "denoise": 1.0
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "3",
          0
        ],
        "vae": [
          "4",
          2
        ]
      }
    },
    "9": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "8",
          0
        ],
        "filename_prefix": "acs/image"
      }
    }
  }
}
